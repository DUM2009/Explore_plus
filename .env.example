# Copia este ficheiro para ".env" (na raiz do projeto) e preenche a tua chave real.
# O ficheiro ".env" nunca é enviado para o git (está no .gitignore).
ANTHROPIC_API_KEY=

# Chaves Stripe (usa chaves de teste "sk_test_..." em desenvolvimento).
# STRIPE_WEBHOOK_SECRET vem do `stripe listen` (local) ou do endpoint de
# webhook criado no Dashboard do Stripe (produção).
# STRIPE_PRICE_ID_PRO é o Price ID impresso por `python manage.py stripe_setup`.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PRO=

# Email de "recuperar password" — opcional em desenvolvimento (sem isto o
# email simplesmente não sai, mas a página continua a funcionar). Mandado
# pela API HTTP da Brevo (brevo.com, conta grátis, 300 emails/dia), não por
# SMTP direto — ver o comentário em render.yaml sobre porque não se usa
# SMTP (o Render bloqueia essas ligações). Chave em app.brevo.com > SMTP &
# API > API Keys, depois de verificares o remetente em Senders.
BREVO_API_KEY=
